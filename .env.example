# --- Database (MySQL) ---
DATABASE_URL=mysql+pymysql://root:password@localhost:3306/wallet_db

# --- JWT ---
JWT_SECRET_KEY=change-me-to-a-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# --- SMTP (leave SMTP_HOST empty to only log emails) ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM=your-email@gmail.com

# --- Admin / app behaviour ---
ADMIN_EMAIL=admin@wallet.com
ADMIN_PASSWORD=Admin@12345
RUN_SCHEDULER=true
SEED_DEMO=true
# Dev only: also return the OTP in the /otp/send response (SMS stand-in for Swagger testing)
OTP_DEV_ECHO=true
